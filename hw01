# [Челлендж]
# 10. Уникальные города и оплаченная выручка по ним (без словарей)
unique_cities = []
revenue_by_city = []

for city, amount, is_paid in zip(cities_clean, amounts_int, paid):
    if is_paid:
        if city in unique_cities:
            idx = unique_cities.index(city)
            revenue_by_city[idx] += amount
        else:
            unique_cities.append(city)
            revenue_by_city.append(amount)

# Сортировка по убыванию выручки (пузырьком)
n = len(revenue_by_city)
for i in range(n):
    for j in range(0, n - i - 1):
        if revenue_by_city[j] < revenue_by_city[j + 1]:
            # Меняем местами выручку
            revenue_by_city[j], revenue_by_city[j + 1] = revenue_by_city[j + 1], revenue_by_city[j]
            # Синхронно меняем города
            unique_cities[j], unique_cities[j + 1] = unique_cities[j + 1], unique_cities[j]

print("Города и выручка (убывание):")
for c, r in zip(unique_cities, revenue_by_city):
    print(f"{c}: {r} ₸")
print()

# 11. Медиана суммы заказа без библиотек
sorted_amounts = sorted(amounts_int)
