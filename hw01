if n_amt % 2 != 0:
    median = sorted_amounts[n_amt // 2]
else:
    median = (sorted_amounts[n_amt // 2 - 1] + sorted_amounts[n_amt // 2]) / 2

print(f"Медиана суммы заказа: {median}\n")

# 12. Текстовая гистограмма выручки по дням
all_days = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"]
day_revenue = {d: 0 for d in all_days}

for day, amount, is_paid in zip(days, amounts_int, paid):
    if is_paid:
        day_revenue[day] += amount

print("Гистрограмма выручки по дням (1 шт. '█' = 5 000 ₸):")
for d in all_days:
    rev = day_revenue[d]
    bars = '█' * (rev // 5000)
    print(f"{d} | {bars:<10} {rev}")
