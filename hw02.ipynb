print()

# 3. Выручка оплаченных заказов и средний чек по категориям
cat_revenue = {}
cat_paid_counts = {}

for r in rows:
    cat = r.get("category", "Неизвестно")
    # Проверяем статус оплаты (в CSV может быть "True", "true", True или 1)
    is_paid_val = str(r.get("paid", "")).strip().lower()
    if is_paid_val in ["true", "1", "yes"]:
        amt = to_num(r.get("amount", 0))
        cat_revenue[cat] = cat_revenue.get(cat, 0.0) + amt
        cat_paid_counts[cat] = cat_paid_counts.get(cat, 0) + 1

print("3. Таблица по категориям (выручка и средний чек оплаченных):")
print(f"{'Категория':<20} | {'Выручка (₸)':<15} | {'Средний чек (₸)':<15}")
print("-" * 58)
for cat, _ in sorted_categories:
    rev = cat_revenue.get(cat, 0.0)
    p_count = cat_paid_counts.get(cat, 0)
    avg_check = rev / p_count if p_count > 0 else 0
    print(f"{cat:<20} | {rev:<15.2f} | {avg_check:<15.2f}")
print()

