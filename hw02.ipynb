# 9. Поиск полных дублей строк через кортежи
seen_rows = set()
duplicates_count = 0
duplicates_by_month = {}

for r in rows:
    # Превращаем значения словаря в неизменяемый кортеж
    row_tuple = tuple(r.items())
    if row_tuple in seen_rows:
        duplicates_count += 1
        date_str = r.get("order_date", "")
        if len(date_str) >= 7:
            m = date_str[:7]
            duplicates_by_month[m] = duplicates_by_month.get(m, 0) + 1
    else:
        seen_rows.add(row_tuple)

print(f"9. Всего полных дублей строк: {duplicates_count}")
print("   Дубли по месяцам:", duplicates_by_month)
print()

